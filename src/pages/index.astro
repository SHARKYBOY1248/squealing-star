---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { getCollection } from "astro:content";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const experience = [
  {
    company: "Reevo",
    href: "https://reevo.ai/",
    blurb: "Built outbound automation and AI-assisted sales workflows.",
  },
  {
    company: "Intel",
    href: "https://intel.com",
    blurb: "Worked on document ingestion for a local RAG assistant.",
  },
  {
    company: "Amazon",
    href: "https://amazon.com",
    blurb: "Built an event-based anomaly detection system.",
  },
  {
    company: "UC Berkeley EECS",
    href: "https://eecs.berkeley.edu/",
    blurb: "Taught undergraduate algorithms (CS 170).",
  },
];

const socialIcons: Record<string, { viewBox: string; path: string }> = {
  Email: {
    viewBox: "0 0 24 24",
    path: "M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z",
  },
  X: {
    viewBox: "0 0 24 24",
    path: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z",
  },
  LinkedIn: {
    viewBox: "0 0 24 24",
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
  YouTube: {
    viewBox: "0 0 24 24",
    path: "M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z",
  },
  Codeforces: {
    viewBox: "0 0 24 24",
    path: "M4.5 7.5C5.328 7.5 6 8.172 6 9v10.5c0 .828-.672 1.5-1.5 1.5h-3C.672 21 0 20.328 0 19.5V9c0-.828.672-1.5 1.5-1.5h3zm9-4.5c.828 0 1.5.672 1.5 1.5v15c0 .828-.672 1.5-1.5 1.5h-3c-.828 0-1.5-.672-1.5-1.5v-15c0-.828.672-1.5 1.5-1.5h3zm9 7.5c.828 0 1.5.672 1.5 1.5v7.5c0 .828-.672 1.5-1.5 1.5h-3c-.828 0-1.5-.672-1.5-1.5V12c0-.828.672-1.5 1.5-1.5h3z",
  },
};
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-16">
        <section class="animate space-y-4">
          <article class="space-y-4">
            <p>
              Hi, I'm Ajit — a software engineer in San Francisco. I studied
              Computer Science at UC Berkeley.
            </p>
            <p>
              I'm committed to learning more about ML systems and inference,
              and I'll be documenting that progress on the
              <Link href="/blog">blog</Link>.
            </p>
            <p>
              Outside of work, I like to lift, play sports (American football
              and tennis are my favorites right now), and make videos.
            </p>
          </article>
        </section>

        <section class="animate space-y-6">
          <h2 class="font-semibold text-black dark:text-white">Experience</h2>
          <ul class="not-prose flex flex-col gap-2">
            {
              experience.map((job) => (
                <li class="text-sm">
                  <Link href={job.href} external>
                    <span class="font-medium text-black dark:text-white">
                      {job.company}
                    </span>
                  </Link>
                  {" — "}
                  {job.blurb}
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              Latest posts
            </h2>
            <Link href="/blog"> See all posts </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              blog.map((post) => (
                <li>
                  <ArrowCard entry={post} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-4">
          <h2 class="font-semibold text-black dark:text-white">
            Let's Connect
          </h2>
          <ul class="not-prose flex flex-wrap items-center gap-2">
            <li>
              <a
                href={`mailto:${SITE.EMAIL}`}
                aria-label={`Email ${SITE.TITLE}`}
                class="group flex size-9 items-center justify-center rounded-sm border border-black/15 hover:bg-black/5 focus-visible:bg-black/5 dark:border-white/20 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
              >
                <svg
                  viewBox={socialIcons.Email.viewBox}
                  width="18"
                  height="18"
                  aria-hidden="true"
                  class="fill-current text-black/70 group-hover:text-black dark:text-white/70 dark:group-hover:text-white"
                >
                  <path d={socialIcons.Email.path}></path>
                </svg>
              </a>
            </li>
            {
              SOCIALS.map((SOCIAL) => (
                <li>
                  <a
                    href={SOCIAL.HREF}
                    target="_blank"
                    aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
                    class="group flex size-9 items-center justify-center rounded-sm border border-black/15 hover:bg-black/5 focus-visible:bg-black/5 dark:border-white/20 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
                  >
                    <svg
                      viewBox={socialIcons[SOCIAL.NAME].viewBox}
                      width="18"
                      height="18"
                      aria-hidden="true"
                      class="fill-current text-black/70 group-hover:text-black dark:text-white/70 dark:group-hover:text-white"
                    >
                      <path d={socialIcons[SOCIAL.NAME].path} />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </aside>
  </Container>
</Layout>
